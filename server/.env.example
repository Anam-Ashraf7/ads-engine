# Copy to .env.local. Paths are relative to this folder unless absolute. Never commit .env.local.

# Your Google OAuth client file and the saved login (npm run login writes TOKEN_FILE).
CLIENT_FILE=C:/path/to/client_secret_....apps.googleusercontent.com.json
TOKEN_FILE=.secrets/refresh-token
PORT=5190

# test = Google Ads TEST accounts only (ads never run, no money). live = real accounts (real money once a campaign runs).
MODE=test

# --- MODE=test ---
# The test manager account and the test client account under it. The server refuses to start unless both are test accounts.
MANAGER_ID=0000000000
CUSTOMER_ID=0000000000

# --- MODE=live ---
# The only real accounts the server may touch, comma-separated (123-456-7890 or 1234567890). Required in live mode;
# every other account is refused.
LIVE_CUSTOMER_IDS=
# Only if those accounts sit under a manager account and you reach them through it. Leave empty otherwise.
LIVE_LOGIN_CUSTOMER_ID=
# Highest daily budget the server will set, in the account's currency.
MAX_DAILY_BUDGET=10
# Monthly spend cap per account, in the account's currency. The server lowers daily budgets as spend nears it and
# pauses every running campaign when it is reached. Checked every CAP_EVERY_HOURS hours, and on demand.
MONTHLY_CAP=20
CAP_EVERY_HOURS=2
# Seconds after start before the first automatic cap check.
CAP_FIRST_RUN_SECONDS=60

# --- Meta (Facebook and Instagram) ads: off until META_ENABLED=true. Nothing below is read while it is off. ---
# META_ENABLED=true
# sandbox = a Meta sandbox ad account (its ads never run). live = real ads. Meta has no field that says which an
# account is, so this server can't check it: only list a sandbox account here while testing.
# META_MODE=sandbox
# The only ad accounts the server may touch, comma-separated, with or without "act_".
# META_AD_ACCOUNT_IDS=
# A file holding the Meta access token. Keep it in .secrets/.
# META_TOKEN_FILE=.secrets/meta-token
# Optional: a file holding the app secret, if the app has "Require App Secret" on.
# META_APP_SECRET_FILE=.secrets/meta-app-secret
# The Facebook Page ads run under. Without it, only a campaign and ad set are created.
# META_PAGE_ID=
# Where test ads link to.
# META_LINK=https://example.com
# Highest daily budget, and monthly spend cap per account, in the account's currency.
# META_MAX_DAILY_BUDGET=10
# META_MONTHLY_CAP=20
# META_CAP_EVERY_HOURS=2
# META_CAP_FIRST_RUN_SECONDS=60
